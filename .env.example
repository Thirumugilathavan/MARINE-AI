# ==============================================================================
# MARINE-AI Platform - Environment Configuration Template
# Copy this file to .env and replace placeholders with your local credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Application Settings
APP_NAME=Sstrix Marine AI Platform
APP_ENV=development
APP_DEBUG=true

# PostgreSQL / PostGIS Database Configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sstrix_marine
DATABASE_USER=sstrix_admin
DATABASE_PASSWORD=your_secure_database_password_here

# SeaweedFS S3-Compatible Object Storage
SEAWEEDFS_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_ACCESS_KEY=your_seaweedfs_access_key_here
SEAWEEDFS_SECRET_KEY=your_seaweedfs_secret_key_here

# SeaweedFS S3 Storage Buckets
SEAWEEDFS_BUCKET_RAW=marine-raw
SEAWEEDFS_BUCKET_CURATED=marine-curated
SEAWEEDFS_BUCKET_DERIVED=marine-derived
SEAWEEDFS_BUCKET_MEDIA=marine-media
SEAWEEDFS_BUCKET_EDNA=marine-edna
SEAWEEDFS_BUCKET_MODELS=marine-models
SEAWEEDFS_BUCKET_RESEARCH=marine-research
